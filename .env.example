# Coolify: use the existing GrokBot Postgres internal URL and actual database role/name.
DATABASE_URL=postgresql://ROLE:URL_ENCODED_PASSWORD@INTERNAL_POSTGRES_HOST:5432/DATABASE
PORT=8000
# Empty for direct localhost use; /sectors behind Traefik StripPrefix.
SECTOR_MAP_BASE=
# Optional: if set, every mutating API route requires this Bearer token.
SECTOR_MAP_TOKEN=
